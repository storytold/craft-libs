# Font-build test fixtures are compared byte for byte: a checkout must not convert them.
crates/fonts-build/tests/fixture/** -text

# The pinned font index is hashed and compiled in as committed: a checkout must not convert its
# line endings, or `Index::bundled` fails its checksum on Windows.
crates/font-store/index/sources.json -text
crates/font-store/index/indexes/*.gz binary

# Copies of the vendored krilla source diff, one per patch (see vendor/krilla/README.craft.md).
vendor/krilla/patches/*.patch linguist-generated=true

# Has a pinned digest and is embedded as bytes by craft-font-store.
crates/font-store/index/sources.json -text

# The build fixture verifies these license files are copied byte-for-byte.
crates/fonts-build/tests/fixture/craft-fonts/fonts/**/OFL.txt -text

# DXF drawing goldens assert exact writer bytes, including LF on every platform.
crates/dxf/tests/data/drawing_*.dxf -text

# The generated components index is compared byte for byte with the generator's LF output (craft-ui test
# components_index): a Windows checkout must not convert its line endings.
docs/components-index.md text eol=lf

# The built-in size files are compared byte for byte with the writer's LF output (craft-theme sizes_tests), and the
# token dumps with the dump writer's (craft-theme dumps test): a Windows checkout must not convert their line endings.
crates/theme/sizes/*.json text eol=lf
crates/theme/tests/dumps/** text eol=lf

# The facade's [features] table is compared with the table the craft features test writes, with LF (craft test
# integration::features): a Windows checkout must not convert its line endings.
crates/craft/Cargo.toml text eol=lf
