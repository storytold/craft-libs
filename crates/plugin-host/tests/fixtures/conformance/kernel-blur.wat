;; Conformance plugin `kernel-blur`. craft_process on a u8 RGBA image: a 9x9 box blur made of a
;; horizontal and a vertical 9 tap pass, with edge clamping, sliding window sums and integer
;; division by 9 after each pass (so the result is exact and engine independent).
;; No params. All four channels are blurred. Rows may have padding (stride_bytes > w * 4).
;; The pass buffer and the column sums come from craft_alloc, so a large image grows memory.
;; Return codes: 0 ok, 2 short descriptor, 3 unsupported image layout, 5 out of memory.
(module
  (memory (export "memory") 8 1024)
  ;; Bump allocator. It grows memory on demand and returns 0 when the grow fails.
  (global $top (mut i32) (i32.const 8192))
  (func $alloc (export "craft_alloc") (param $len i32) (param $align i32) (result i32)
    (local $p i32) (local $end i64) (local $have i64) (local $pages i32)
    (local.set $p (i32.and
      (i32.add (global.get $top) (i32.sub (local.get $align) (i32.const 1)))
      (i32.xor (i32.sub (local.get $align) (i32.const 1)) (i32.const -1))))
    (local.set $end (i64.add (i64.extend_i32_u (local.get $p)) (i64.extend_i32_u (local.get $len))))
    (if (i64.gt_u (local.get $end) (i64.const 0xFFFFFFFF)) (then (return (i32.const 0))))
    (local.set $have (i64.shl (i64.extend_i32_u (memory.size)) (i64.const 16)))
    (if (i64.gt_u (local.get $end) (local.get $have))
      (then
        (local.set $pages (i32.wrap_i64 (i64.shr_u (i64.add (i64.sub (local.get $end) (local.get $have)) (i64.const 65535)) (i64.const 16))))
        (if (i32.eq (memory.grow (local.get $pages)) (i32.const -1)) (then (return (i32.const 0))))))
    (global.set $top (i32.add (local.get $p) (local.get $len)))
    (local.get $p))
  (func (export "craft_abi") (result i32) i32.const 1)
  (func (export "craft_free") (param i32 i32 i32))
  (func $min (param i32 i32) (result i32) (select (local.get 0) (local.get 1) (i32.lt_s (local.get 0) (local.get 1))))
  (func $max (param i32 i32) (result i32) (select (local.get 0) (local.get 1) (i32.gt_s (local.get 0) (local.get 1))))
  (func (export "craft_process") (param $d i32) (param $dl i32) (result i32)
    (local $w i32) (local $h i32) (local $stride i32) (local $in i32) (local $out i32)
    (local $rowb i32) (local $tmp i32) (local $sums i32)
    (local $y i32) (local $x i32) (local $c i32) (local $i i32) (local $k i32) (local $sum i32)
    (local $row i32) (local $trow i32) (local $yy i32)
    (if (i32.lt_u (local.get $dl) (i32.const 96)) (then (return (i32.const 2))))
    (if (i32.ne (i32.load offset=4 (local.get $d)) (i32.const 1)) (then (return (i32.const 3))))
    (if (i32.ne (i32.load offset=24 (local.get $d)) (i32.const 4)) (then (return (i32.const 3))))
    (if (i32.ne (i32.load offset=28 (local.get $d)) (i32.const 1)) (then (return (i32.const 3))))
    (local.set $w (i32.load offset=12 (local.get $d)))
    (local.set $h (i32.load offset=16 (local.get $d)))
    (local.set $stride (i32.load offset=20 (local.get $d)))
    (local.set $in (i32.load offset=80 (local.get $d)))
    (local.set $out (i32.load offset=84 (local.get $d)))
    (if (i32.or (i32.eqz (local.get $w)) (i32.eqz (local.get $h))) (then (return (i32.const 0))))
    (local.set $rowb (i32.shl (local.get $w) (i32.const 2)))
    (local.set $tmp (call $alloc (i32.mul (local.get $rowb) (local.get $h)) (i32.const 4)))
    (local.set $sums (call $alloc (i32.shl (local.get $rowb) (i32.const 2)) (i32.const 4)))
    (if (i32.or (i32.eqz (local.get $tmp)) (i32.eqz (local.get $sums))) (then (return (i32.const 5))))
    ;; horizontal pass: in -> tmp
    (local.set $y (i32.const 0))
    (block $hy (loop $hyl
      (br_if $hy (i32.ge_u (local.get $y) (local.get $h)))
      (local.set $row (i32.add (local.get $in) (i32.mul (local.get $y) (local.get $stride))))
      (local.set $trow (i32.add (local.get $tmp) (i32.mul (local.get $y) (local.get $rowb))))
      (local.set $c (i32.const 0))
      (block $hc (loop $hcl
        (br_if $hc (i32.ge_u (local.get $c) (i32.const 4)))
        ;; window sum for x = 0: columns -4..4 clamped to 0..w-1
        (local.set $sum (i32.const 0))
        (local.set $k (i32.const -4))
        (block $hk (loop $hkl
          (br_if $hk (i32.gt_s (local.get $k) (i32.const 4)))
          (local.set $sum (i32.add (local.get $sum)
            (i32.load8_u (i32.add (i32.add (local.get $row) (local.get $c))
              (i32.shl (call $max (i32.const 0) (call $min (local.get $k) (i32.sub (local.get $w) (i32.const 1)))) (i32.const 2))))))
          (local.set $k (i32.add (local.get $k) (i32.const 1)))
          (br $hkl)))
        (local.set $x (i32.const 0))
        (block $hx (loop $hxl
          (br_if $hx (i32.ge_u (local.get $x) (local.get $w)))
          (i32.store8 (i32.add (i32.add (local.get $trow) (i32.shl (local.get $x) (i32.const 2))) (local.get $c))
            (i32.div_u (local.get $sum) (i32.const 9)))
          (local.set $sum (i32.sub
            (i32.add (local.get $sum)
              (i32.load8_u (i32.add (i32.add (local.get $row) (local.get $c))
                (i32.shl (call $min (i32.add (local.get $x) (i32.const 5)) (i32.sub (local.get $w) (i32.const 1))) (i32.const 2)))))
            (i32.load8_u (i32.add (i32.add (local.get $row) (local.get $c))
              (i32.shl (call $max (i32.sub (local.get $x) (i32.const 4)) (i32.const 0)) (i32.const 2))))))
          (local.set $x (i32.add (local.get $x) (i32.const 1)))
          (br $hxl)))
        (local.set $c (i32.add (local.get $c) (i32.const 1)))
        (br $hcl)))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br $hyl)))
    ;; vertical pass: column sums for y = 0 over rows -4..4 clamped
    (local.set $k (i32.const -4))
    (block $vk (loop $vkl
      (br_if $vk (i32.gt_s (local.get $k) (i32.const 4)))
      (local.set $yy (call $max (i32.const 0) (call $min (local.get $k) (i32.sub (local.get $h) (i32.const 1)))))
      (local.set $trow (i32.add (local.get $tmp) (i32.mul (local.get $yy) (local.get $rowb))))
      (local.set $i (i32.const 0))
      (block $vi (loop $vil
        (br_if $vi (i32.ge_u (local.get $i) (local.get $rowb)))
        (i32.store (i32.add (local.get $sums) (i32.shl (local.get $i) (i32.const 2)))
          (i32.add (i32.load (i32.add (local.get $sums) (i32.shl (local.get $i) (i32.const 2))))
                   (i32.load8_u (i32.add (local.get $trow) (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $vil)))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br $vkl)))
    (local.set $y (i32.const 0))
    (block $vy (loop $vyl
      (br_if $vy (i32.ge_u (local.get $y) (local.get $h)))
      (local.set $row (i32.add (local.get $out) (i32.mul (local.get $y) (local.get $stride))))
      (local.set $trow (i32.add (local.get $tmp) (i32.mul (call $min (i32.add (local.get $y) (i32.const 5)) (i32.sub (local.get $h) (i32.const 1))) (local.get $rowb))))
      (local.set $yy (i32.add (local.get $tmp) (i32.mul (call $max (i32.sub (local.get $y) (i32.const 4)) (i32.const 0)) (local.get $rowb))))
      (local.set $i (i32.const 0))
      (block $vx (loop $vxl
        (br_if $vx (i32.ge_u (local.get $i) (local.get $rowb)))
        (local.set $sum (i32.load (i32.add (local.get $sums) (i32.shl (local.get $i) (i32.const 2)))))
        (i32.store8 (i32.add (local.get $row) (local.get $i)) (i32.div_u (local.get $sum) (i32.const 9)))
        (i32.store (i32.add (local.get $sums) (i32.shl (local.get $i) (i32.const 2)))
          (i32.sub (i32.add (local.get $sum) (i32.load8_u (i32.add (local.get $trow) (local.get $i))))
                   (i32.load8_u (i32.add (local.get $yy) (local.get $i)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $vxl)))
      (local.set $y (i32.add (local.get $y) (i32.const 1)))
      (br $vyl)))
    (i32.const 0))
  (func (export "craft_invoke") (param i32 i32 i32 i32 i32) (result i64) i64.const 0))
