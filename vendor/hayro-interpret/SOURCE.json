    "changes": [
      "Use whole-dictionary resource scopes for forms, Type 3 procedures and tiling patterns.",
      "Paint the entire Tj or TJ fill pass before its stroke pass by bounded source replay, retaining the existing Device API.",
      "Add rounded byte transfer evaluation with identity fallback on failed or non-finite samples."
    ],
    "preserved": [
      "Existing Type 3 single-paint rendering-mode behavior, font handling, incomplete-content diagnostics and interpreter budgets.",
      "Existing Bradford Lab conversion and full-precision calibrated and tint color conversion; no LAB.icc asset or broad color backend replacement."
    ]
  },
  "local_test_updates": [
    "Adjust direct stitching-function fixtures to the 32/33-function boundary imposed by the 64-container syntax cap and independently test unchanged 64/65-function construction limits with indirect references."
  ]
